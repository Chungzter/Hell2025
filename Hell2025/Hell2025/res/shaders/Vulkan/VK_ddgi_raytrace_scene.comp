#version 460
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_ray_query : require

#include "../common/constants.glsl"
#include "../common/util.glsl"
#include "../common/viewport.glsl"
#include "../common/Vulkan/VK_binding_indices.glsl"
#include "../common/Vulkan/VK_push_constants.glsl"
#include "../common/Vulkan/VK_ray_query.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = DESC_IDX_STORAGE_IMAGES_RGBA16F, rgba16f) uniform image2D storageImagesRGBA16F[];
layout(set = 1, binding = 0) uniform accelerationStructureEXT u_DDGIRayQueryAccelerationStructure;

layout(buffer_reference, scalar) readonly buffer ViewportDataBuffer { ViewportData viewportDataArr[]; };
layout(buffer_reference, scalar) readonly buffer RendererDataBuffer { RendererData rendererData; };

struct PackedVertex {
    float vx, vy, vz;
    float nx, ny, nz;
    float u, v;
    float tx, ty, tz;
};

layout(buffer_reference, scalar) readonly buffer VertexBuffer {
    PackedVertex vertices[];
};

layout(buffer_reference, scalar) readonly buffer IndexBuffer {
    uint indices[];
};

layout(push_constant, scalar) uniform PushConstants {
    PushConstantsDDGIRaytraceScene data;
} pushConstant;

const float MISS_DISTANCE = 65504.0;

bool ResolveDDGIHitNormal(RayQueryTriangleHit hit, out vec3 worldNormal) {
    uint64_t vertexBufferAddress = hit.instanceCustomIndex == 0u ? pushConstant.data.houseVertexBufferDeviceAddress : pushConstant.data.doorVertexBufferDeviceAddress;
    uint64_t indexBufferAddress = hit.instanceCustomIndex == 0u ? pushConstant.data.houseIndexBufferDeviceAddress : pushConstant.data.doorIndexBufferDeviceAddress;

    VertexBuffer vertexBuffer = VertexBuffer(vertexBufferAddress);
    IndexBuffer indexBuffer = IndexBuffer(indexBufferAddress);

    uint triangleIndexOffset = hit.primitiveIndex * 3u;
    uint i0 = indexBuffer.indices[triangleIndexOffset + 0u];
    uint i1 = indexBuffer.indices[triangleIndexOffset + 1u];
    uint i2 = indexBuffer.indices[triangleIndexOffset + 2u];

    vec3 v0 = vec3(vertexBuffer.vertices[i0].vx, vertexBuffer.vertices[i0].vy, vertexBuffer.vertices[i0].vz);
    vec3 v1 = vec3(vertexBuffer.vertices[i1].vx, vertexBuffer.vertices[i1].vy, vertexBuffer.vertices[i1].vz);
    vec3 v2 = vec3(vertexBuffer.vertices[i2].vx, vertexBuffer.vertices[i2].vy, vertexBuffer.vertices[i2].vz);

    vec3 objectNormal = normalize(cross(v1 - v0, v2 - v0));
    worldNormal = normalize(hit.objectToWorld * vec4(objectNormal, 0.0));
    return dot(worldNormal, worldNormal) > 0.0;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(storageImagesRGBA16F[VULKAN_STORAGE_IMAGE_IDX_GBUFFER_LIGHTING]);
    if (px.x >= outputSize.x || px.y >= outputSize.y) return;

    vec4 previous = imageLoad(storageImagesRGBA16F[VULKAN_STORAGE_IMAGE_IDX_GBUFFER_LIGHTING], px);
    vec3 outputColor = previous.rgb;
    float outputDistance = previous.a;

    if (pushConstant.data.clearOutput != 0u) {
        outputColor = vec3(0.0);
        outputDistance = MISS_DISTANCE;
    }

    ViewportDataBuffer viewportDataBuffer = ViewportDataBuffer(pushConstant.data.frame.viewportDataDeviceAddress);
    RendererDataBuffer rendererDataBuffer = RendererDataBuffer(pushConstant.data.frame.rendererDataDeviceAddress);

    RendererData rendererData = rendererDataBuffer.rendererData;
    uint viewportIndex = ViewportIndexFromSplitScreenMode_VK(px, outputSize, rendererData.splitscreenMode);
    ViewportData viewportData = viewportDataBuffer.viewportDataArr[viewportIndex];

    vec3 rayOrigin = viewportData.viewPos.xyz;
    vec2 viewportOrigin = vec2(viewportData.xOffset, outputSize.y - viewportData.yOffset - viewportData.height);
    vec2 viewportSize = vec2(viewportData.width, viewportData.height);
    vec3 rayDir = GetWorldRay_VK(vec2(px) + 0.5, viewportData.inverseProjectionViewReverseZ, rayOrigin, viewportOrigin, viewportSize);

    RayQueryTriangleHit hit;
    if (RayQueryTraceClosestTriangle(u_DDGIRayQueryAccelerationStructure, 0u, 0xff, rayOrigin, 0.01, rayDir, pushConstant.data.maxRayDistance, hit)) {
        if (hit.t < outputDistance) {
            vec3 normal;
            if (ResolveDDGIHitNormal(hit, normal)) {
                outputColor = normal * 0.5 + 0.5;
            } else {
                outputColor = vec3(1.0, 0.0, 1.0);
            }
            outputDistance = hit.t;
        }
    }

    imageStore(storageImagesRGBA16F[VULKAN_STORAGE_IMAGE_IDX_GBUFFER_LIGHTING], px, vec4(outputColor, outputDistance));
}
