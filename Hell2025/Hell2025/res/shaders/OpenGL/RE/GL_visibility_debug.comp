#version 460
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rg32ui, binding = 0) uniform readonly uimage2D u_VisibilityBuffer;
layout(rgba16f, binding = 1) uniform writeonly image2D out_VisualizationTarget;

vec3 IntegerToColor(uint x) {
    x = ((x >> 16) ^ x) * 0x45d9f3bE;
    x = ((x >> 16) ^ x) * 0x45d9f3bE;
    x = (x >> 16) ^ x;
    return vec3(
        float(x & 0xFFu) / 255.0,
        float((x >> 8) & 0xFFu) / 255.0,
        float((x >> 16) & 0xFFu) / 255.0
    );
}

void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 texSize = imageSize(u_VisibilityBuffer);
    
    if (pixelCoords.x >= texSize.x || pixelCoords.y >= texSize.y) {
        return;
    }

    uvec4 visibilityData = imageLoad(u_VisibilityBuffer, pixelCoords);
    uint meshID = visibilityData.x;
    uint primitiveID = visibilityData.y;

    // Check if background pixel
    if (meshID == 0 && primitiveID == 0) {
        imageStore(out_VisualizationTarget, pixelCoords, vec4(0.05, 0.05, 0.05, 1.0));
        return;
    }

    // Generate distinctive color configurations
    vec3 meshColor = IntegerToColor(meshID);
    vec3 primColor = IntegerToColor(primitiveID);

    // Combine paths to highlight distinct meshes while showing individual triangles
    vec3 finalColor = mix(meshColor, primColor, 0.2);

    imageStore(out_VisualizationTarget, pixelCoords, vec4(finalColor, 1.0));
}