#version 450
layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "../../common/normal_encoding.glsl"

layout(rgba16f, binding = 0) uniform image2D u_lightingImage;
layout(binding = 1) uniform sampler2D        u_materialSampler; // Resolve
layout(binding = 2) uniform sampler2DMS      u_hairTestSampler;
layout(binding = 3) uniform sampler2D        u_indirectDiffuseSampler;
layout(binding = 4) uniform sampler2D        u_resolvedHairTest;
layout(binding = 5) uniform sampler2D        u_hairMLABResolveSampler;
layout(binding = 6) uniform sampler2DMS      u_normalSampler;
layout(binding = 7) uniform sampler2DMS      u_reNormalSampler;

vec4 ResolveHairMSAA(ivec2 coord) {
    vec4 result = vec4(0.0);
    int sampleCount = int(textureSamples(u_hairTestSampler));

    for (int sampleIndex = 0; sampleIndex < sampleCount; sampleIndex++) {
        result += texelFetch(u_hairTestSampler, coord, sampleIndex);
    }

    return result / float(sampleCount);
}

vec4 SampleHairBilinear(ivec2 px, vec2 fullResolution, vec2 halfResolution) {
    vec2 uv = (vec2(px) + 0.5) / fullResolution;
    vec2 halfTexelPosition = uv * halfResolution - 0.5;

    ivec2 baseCoord = ivec2(floor(halfTexelPosition));
    vec2 blendFactor = fract(halfTexelPosition);

    ivec2 maxCoord = ivec2(halfResolution) - ivec2(1);

    ivec2 c00 = clamp(baseCoord + ivec2(0, 0), ivec2(0), maxCoord);
    ivec2 c10 = clamp(baseCoord + ivec2(1, 0), ivec2(0), maxCoord);
    ivec2 c01 = clamp(baseCoord + ivec2(0, 1), ivec2(0), maxCoord);
    ivec2 c11 = clamp(baseCoord + ivec2(1, 1), ivec2(0), maxCoord);

    vec4 h00 = ResolveHairMSAA(c00);
    vec4 h10 = ResolveHairMSAA(c10);
    vec4 h01 = ResolveHairMSAA(c01);
    vec4 h11 = ResolveHairMSAA(c11);

    vec4 hx0 = mix(h00, h10, blendFactor.x);
    vec4 hx1 = mix(h01, h11, blendFactor.x);

    return mix(hx0, hx1, blendFactor.y);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    vec2 size = vec2(imageSize(u_lightingImage));

    if (px.x >= size.x || px.y >= size.y) return;
    
    vec2 uv = (vec2(px) + 0.5) / vec2(size);

    vec4 lighting = imageLoad(u_lightingImage, px);
    vec3 probeIrradiance = texture(u_indirectDiffuseSampler, uv).rgb;
    vec4 material = texture(u_materialSampler, uv);
    
    float metallic = material.g;
    float ao = material.b;

    vec3 gammaBaseColor = material.rgb;

    vec3 diffuseAlbedo = gammaBaseColor.rgb * (1.0 - metallic);
    float indirectDiffuseScale = 1.0;
    vec3 indirectDiffuse = probeIrradiance * diffuseAlbedo * ao * indirectDiffuseScale;
	//lighting.rgb += indirectDiffuse.rgb;
    
   // vec4 hair = texture(u_hairTestSampler2, uv);

    vec4 hair = vec4(0);
    int sampleCount = int(textureSamples(u_hairTestSampler));
    for (int i = 0; i < sampleCount; i++) {
        hair += texelFetch(u_hairTestSampler, px / 2, i);
    }
    hair /= sampleCount;

    
    vec2 fullResolution = vec2(imageSize(u_lightingImage));
    vec2 halfResolution = vec2(textureSize(u_hairTestSampler));
    
    //hair = SampleHairBilinear(px, fullResolution, halfResolution);
    
    //vec4 resolvedHairTest = texture(u_resolvedHairTest, uv);
    vec4 resolvedHairTest = texelFetch(u_resolvedHairTest, px / 2, 0);

    //hair = texture(u_hairMLABResolveSampler, uv);

    // Perform alpha compositing (hair over lighting)
    vec3 blendedColor = hair.rgb + lighting.rgb * (1.0 - hair.a);
    float blendedAlpha = hair.a + lighting.a * (1.0 - hair.a);
    
    vec4 finalOutput = vec4(blendedColor, blendedAlpha);
    
    //finalOutput = lighting;
    //finalOutput = hair;
    //finalOutput = resolvedHairTest;

    imageStore(u_lightingImage, px, vec4(finalOutput));
    //imageStore(u_lightingImage, px, vec4(lighting));

    //vec4 hairMLAB = texture(u_hairMLABResolveSampler, uv);
    //imageStore(u_lightingImage, px, vec4(hairMLAB.rgb, 1.0));

    //vec4 hairMLAB2 = texelFetch(u_hairMLABResolveSampler, px / 2, 0);
    //imageStore(u_lightingImage, px, hairMLAB2);
    
    vec3 rawNormal = texelFetch(u_normalSampler, px, 0).rgb;
    vec3 normal = normalize(rawNormal * 2.0 - 1.0);

    vec3 reNormal = texelFetch(u_reNormalSampler, px, 0).rgb;
    normal = DecodeNormal(reNormal.rg);
    
    //imageStore(u_lightingImage, px, vec4(normal, 1.0));
}