layout(local_size_x = TILE_SIZE, local_size_y = TILE_SIZE, local_size_z = 1) in;

layout(rgba16f, binding = 0) uniform image2D u_outputImage;

#if defined(RE_ENABLED)
layout (binding = 1) uniform sampler2D BaseColorMetallic;
layout (binding = 2) uniform sampler2D NormalXYRoughnessMisc;
layout (binding = 3) uniform sampler2D VelocityXYOcclusionSubSurface;
layout (binding = 9) uniform usampler2D VisibilityTexture;
#else
layout (binding = 1) uniform sampler2D BaseColorMetallic;
layout (binding = 2) uniform sampler2D NormalXYRoughnessMisc;
layout (binding = 3) uniform sampler2D VelocityXYOcclusionSubSurface;
layout (binding = 6) uniform sampler2D GBufferWorldMirrorMaskTexture;
layout (binding = 7) uniform sampler2D GBufferEmissiveTexture;
#endif

layout (binding = 8) uniform sampler2D IndirectDiffuseTexture;

layout (binding = 10) uniform usampler2D u_oceanFlagsTexture;
layout (binding = 11) uniform sampler2D u_depthTexture;
layout (binding = 12) uniform sampler2D u_emissiveTexture;

readonly restrict layout(std430, binding = 2) buffer rendererDataBuffer { RendererData rendererData; };
readonly restrict layout(std430, binding = 3) buffer viewportDataBuffer { ViewportData viewportDataArr[]; };

#define NONE 0
#define BASE_COLOR 1
#define NORMALS 2
#define RMA 3
#define ROUGHNESS 4
#define METALLIC 5
#define AO 6
#define CAMERA_NDOTL 7
#define TILE_HEATMAP_LIGHTS 8,
#define TILE_HEATMAP_BLOOD_DECALS 9
#define TILE_HEATMAP_CHRISTMAS_LIGHTS 10
#define INDIRECT_DIFFUSE 11
#define VELOCITY 12
#define VIS_BUFFER 13
#define DEPTH 14
#define WORLD_POSITION 15
#define EMISSIVE 16

vec3 IntegerToColor(uint x) {
    x = ((x >> 16) ^ x) * 0x45d9f3bE;
    x = ((x >> 16) ^ x) * 0x45d9f3bE;
    x = (x >> 16) ^ x;
    return vec3(float(x & 0xFFu) / 255.0, float((x >> 8) & 0xFFu) / 255.0, float((x >> 16) & 0xFFu) / 255.0);
}

