}

vec3 GetCameraNdotL(ivec2 px) {
    ivec2 outputImageSize = imageSize(u_outputImage);
    uint viewportIndex = ComputeViewportIndexFromSplitscreenMode(px, outputImageSize, rendererData.splitscreenMode);
    vec2 screenUV = (vec2(px) + 0.5) / vec2(outputImageSize);
    vec2 viewportUV = ScreenUVToViewportUV(screenUV, viewportDataArr[viewportIndex]);

    ViewportData viewportData = viewportDataArr[viewportIndex];
    mat4 inverseView = viewportData.inverseView;

    vec3 normal = GetNormal(px);
    vec3 lightDir = normalize(inverseView[2].xyz);
    float ndotl = max(dot(normal.xyz, lightDir), 0.0);

    return GetBaseColor(px) * ndotl;
    //return vec3(ndotl);
}

vec3 GetIndirectDiffuse(ivec2 px) {
    ivec2 outputImageSize = imageSize(u_outputImage);
    vec2 screenUV = (vec2(px) + 0.5) / vec2(outputImageSize);
    vec3 indirectDiffuseTexture =  texture(IndirectDiffuseTexture, screenUV).rgb;
    vec3 result = Tonemap_ACES(indirectDiffuseTexture);
    result = pow(result, vec3(1.0 / 2.2));
    result = clamp(result, 0, 1);
    result = mix(result, Tonemap_ACES(result), 0.125);
    return (result);
}

vec3 GetVelocity(ivec2 px) {
    vec2 velocity = vec2(0);
    //#if defined(RE_ENABLED)
        velocity = texelFetch(VelocityXYOcclusionSubSurface, px, 0).rg;
    //#else
    //    velocity = texelFetch(VelocityOcclusionSubSurface, px, 0).rg;
    //#endif
    float gain = 20.0;
    return vec3(velocity * gain + 0.5, 0.5);
}

vec3 GetVisBuffer(ivec2 px) {
    #if defined(RE_ENABLED)
    uvec2 visibilityData = texelFetch(VisibilityTexture, px, 0).rg;
    #else
    uvec2 visibilityData = uvec2(0, 0);
    #endif

    uint meshID = visibilityData.x;
    uint primitiveID = visibilityData.y;

    // Check if background pixel
    if (meshID == 0 && primitiveID == 0) {
        return vec3(0.05, 0.05, 0.05);
    }

    // Generate distinctive color configurations
    vec3 meshColor = IntegerToColor(meshID);
    vec3 primColor = IntegerToColor(primitiveID);

    // Combine paths to highlight distinct meshes while showing individual triangles
    return mix(meshColor, primColor, 0.2);
}

vec3 GetVisBufferUVs(ivec2 px) {
    #if defined(RE_ENABLED)
    uvec2 visibilityData = texelFetch(VisibilityTexture, px, 0).rg;

    #else
    return vec3(0, 0, 0);
    #endif

    return vec3(0, 0, 0);
}

vec3 GetDepth(ivec2 px) {
    float depth = texelFetch(u_depthTexture, px, 0).r;
    return vec3(depth, 0, 0);
}

vec3 GetWorldPosition(ivec2 px) {
    ivec2 outputImageSize = imageSize(u_outputImage);
    uint viewportIndex = ComputeViewportIndexFromSplitscreenMode(px, outputImageSize, rendererData.splitscreenMode);
    vec2 screenUV = (vec2(px) + 0.5) / vec2(outputImageSize);
    vec2 viewportUV = ScreenUVToViewportUV(screenUV, viewportDataArr[viewportIndex]);

    ViewportData viewportData = viewportDataArr[viewportIndex];
    mat4 inverseProjectionViewReverseZ = viewportData.inverseProjectionViewReverseZ;

    float depth = texelFetch(u_depthTexture, px, 0).r;
    return ReconstructWorldPos(viewportUV, depth, inverseProjectionViewReverseZ);
}

vec3 GetEmissive(ivec2 px) {
    return texelFetch(u_emissiveTexture, px, 0).rgb;
}

void main() {
	ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputImageSize = imageSize(u_outputImage);
    if (px.x >= outputImageSize.x || px.y >= outputImageSize.y) return;

    vec3 finalColor = vec3(0, 0, 0);

    if (rendererData.rendererOverrideState == BASE_COLOR)       finalColor = GetBaseColor(px);
    if (rendererData.rendererOverrideState == NORMALS)          finalColor = GetNormal(px);
    if (rendererData.rendererOverrideState == RMA)              finalColor = GetRMA(px);
    if (rendererData.rendererOverrideState == ROUGHNESS)        finalColor = GetRoughness(px);
    if (rendererData.rendererOverrideState == METALLIC)         finalColor = GetMetallic(px);
    if (rendererData.rendererOverrideState == AO)               finalColor = GetAO(px);
    if (rendererData.rendererOverrideState == CAMERA_NDOTL)     finalColor = GetCameraNdotL(px);
    if (rendererData.rendererOverrideState == INDIRECT_DIFFUSE) finalColor = GetIndirectDiffuse(px);
    if (rendererData.rendererOverrideState == VELOCITY)         finalColor = GetVelocity(px);
    if (rendererData.rendererOverrideState == VIS_BUFFER)       finalColor = GetVisBuffer(px);
    if (rendererData.rendererOverrideState == DEPTH)            finalColor = GetDepth(px);
    if (rendererData.rendererOverrideState == WORLD_POSITION)   finalColor = GetWorldPosition(px);
    if (rendererData.rendererOverrideState == EMISSIVE)         finalColor = GetEmissive(px);

    imageStore(u_outputImage, px, vec4(finalColor, 1));


    //vec3 test = texelFetch(VelocityXYOcclusionSubSurface, px, 0).rgb;
    //imageStore(u_outputImage, px, vec4(test, 1));

}
